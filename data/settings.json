{
  "monitoring": {
    "enabled": true,
    "perAppEnabled": true,
    "adapterId": "auto",
    "updateIntervalMs": 1000,
    "showInactiveApps": true,
    "groupByExe": true
  },
  "diagnostics": {
    "pingTargets": [
      {
        "id": "cloudflare",
        "name": "Cloudflare DNS",
        "host": "1.1.1.1"
      },
      {
        "id": "google",
        "name": "Google Public DNS",
        "host": "8.8.8.8"
      },
      {
        "id": "quad9",
        "name": "Quad9 DNS",
        "host": "9.9.9.9"
      },
      {
        "id": "microsoft",
        "name": "Microsoft Azure",
        "host": "20.190.159.0"
      }
    ],
    "activePingTarget": "1.1.1.1",
    "pingIntervalMs": 2000,
    "pingTimeoutMs": 1500,
    "mode": "tcp"
  },
  "startup": {
    "startWithWindows": true,
    "launchMinimized": false,
    "minimizeToTrayOnClose": true,
    "keepMonitoringInTray": true,
    "showTraySpeedTooltip": true
  },
  "storage": {
    "dataRetentionDays": 30,
    "autoPrune": true
  },
  "appearance": {
    "theme": "dark",
    "accentColor": "#38bdf8",
    "defaultCanvasMode": "portrait_9_16",
    "chartStyle": "area"
  }
}